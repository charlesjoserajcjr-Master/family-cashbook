{
  "name": "family-cashbook-desktop",
  "productName": "ReadyTrove Family Money",
  "version": "1.0.0",
  "description": "ReadyTrove Family Money for Windows: plan, track and forecast your family's money, fully offline.",
  "author": "READYTROVE TECHNOLOGIES",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": ">=37.0.0 <100.0.0",
    "electron-builder": ">=25.0.0 <30.0.0"
  },
  "build": {
    "appId": "com.familycashbook.desktop",
    "productName": "ReadyTrove Family Money",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*",
      "wifi-relay.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReadyTrove Family Money",
      "artifactName": "Family-Money-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Family-Money-Portable-${version}.${ext}"
    }
  }
}
