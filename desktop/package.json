{
  "name": "family-cashbook-desktop",
  "productName": "Family Cashbook",
  "version": "1.0.0",
  "description": "Family Cashbook for Windows: plan, track and forecast your family's money, fully offline.",
  "author": "Charles",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": ">=37.0.0 <100.0.0",
    "electron-builder": ">=25.0.0 <30.0.0"
  },
  "build": {
    "appId": "com.familycashbook.desktop",
    "productName": "Family Cashbook",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "www/**/*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Family Cashbook",
      "artifactName": "Family-Cashbook-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Family-Cashbook-Portable-${version}.${ext}" }
  }
}
